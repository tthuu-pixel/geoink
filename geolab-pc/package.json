{
  "name": "geolab-pc",
  "productName": "GeoLab",
  "version": "1.0.0",
  "description": "GeoLab – Hình học tương tác THCS, chạy trên máy tính Windows không cần mạng.",
  "main": "main.js",
  "author": "Nhóm nghiên cứu khoa học trường TH-THCS An Lạc",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "35.7.5",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "vn.geolab.pc",
    "productName": "GeoLab",
    "copyright": "Nhóm nghiên cứu khoa học trường TH-THCS An Lạc",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "build/icon.png", "package.json"],
    "extraResources": [{ "from": "web", "to": "web", "filter": ["**/*", ".phien-ban.json", ".ds.json"] }],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GeoLab",
      "artifactName": "GeoLab-Setup-${version}.${ext}"
    },
    "publish": [{ "provider": "generic", "url": "https://github.com/tthuu-pixel/geoink/releases/download/geolab-pc" }]
  }
}
